generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  passwordHash        String
  role                Role           @default(MEMBER)
  isActive            Boolean        @default(true)
  weeklyHourTarget    Float          @default(35)
  notificationsEnabled Boolean       @default(true)
  createdAt           DateTime       @default(now())
  timeEntries         TimeEntry[]
  expenses            Expense[]
  mileageEntries      MileageEntry[]
  tasks               Task[]
  milestones          Milestone[]
}

model Client {
  id           String         @id @default(cuid())
  name         String
  emails       String[]
  keywords     String[]
  notes        String?
  isActive     Boolean        @default(true)
  isInternal   Boolean        @default(false)
  createdAt    DateTime       @default(now())
  projects     Project[]
  expenses     Expense[]
  mileage      MileageEntry[]
  contacts     ClientContact[]
}

model ClientContact {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  role      String?
  isPrimary Boolean @default(false)
}

model Project {
  id              String                 @id @default(cuid())
  clientId        String
  client          Client                 @relation(fields: [clientId], references: [id])
  name            String
  type            ProjectType
  status          ProjectStatus          @default(OPEN)
  budgetHours     Float?
  budgetDollars   Float?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean                @default(true)
  notes           String?
  scopeOfWork     String?
  sowNumber       String?
  createdAt       DateTime               @default(now())
  timeEntries     TimeEntry[]
  projectTasks    ProjectTask[]
  retainerConfig  RetainerConfig?
  expenseConfigs  ProjectExpenseConfig[]
  tasks           Task[]
  milestones      Milestone[]
  payments        PaymentInstallment[]
  fileLinks       FileLink[]
  callLogs        CallLog[]
}

model Task {
  id               String        @id @default(cuid())
  projectId        String
  project          Project       @relation(fields: [projectId], references: [id])
  deliverableId    String?
  deliverable      ProjectTask?  @relation(fields: [deliverableId], references: [id])
  title            String
  notes            String?
  assigneeUserId   String?
  assigneeUser     User?         @relation(fields: [assigneeUserId], references: [id])
  assigneeName     String?
  isSubcontractor  Boolean       @default(false)
  subHours         Float?
  subExpenseAmount Float?
  priority         TaskPriority  @default(MEDIUM)
  status           TaskStatus    @default(TODO)
  dueDate          DateTime?
  rank             Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  timeEntries      TimeEntry[]
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  status      MilestoneStatus @default(UPCOMING)
  dueDate     DateTime?
  completedAt DateTime?
  ownerId     String?
  owner       User?           @relation(fields: [ownerId], references: [id])
  tags        String[]
  atRisk      Boolean         @default(false)
  sortOrder   Int             @default(0)
  notes       String?
}

model PaymentInstallment {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  amount    Float
  dueDate   DateTime?
  isPaid    Boolean   @default(false)
  paidAt    DateTime?
  payeeType PayeeType @default(CLIENT)
  payeeName String?
  sortOrder Int       @default(0)
}

model FileLink {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label     String
  url       String
  createdAt DateTime @default(now())
}

model CallLog {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  summary   String?
  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
}

model TaskType {
  id                  String        @id @default(cuid())
  name                String        @unique
  defaultHourlyRate   Float         @default(0)
  isBillableDefault   Boolean       @default(true)
  isArchived          Boolean       @default(false)
  createdAt           DateTime      @default(now())
  projectTasks        ProjectTask[]
  timeEntries         TimeEntry[]
}

model ProjectTask {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id])
  taskTypeId    String
  taskType      TaskType  @relation(fields: [taskTypeId], references: [id])
  isActive      Boolean   @default(true)
  forecastHours Float?
  tasks         Task[]

  @@unique([projectId, taskTypeId])
}

model TimeEntry {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id])
  projectId           String
  project             Project      @relation(fields: [projectId], references: [id])
  taskTypeId          String
  taskType            TaskType     @relation(fields: [taskTypeId], references: [id])
  taskId              String?
  task                Task?        @relation(fields: [taskId], references: [id])
  date                DateTime
  hours               Float
  hourlyRate          Float
  isBillable          Boolean      @default(true)
  note                String?
  noteClientVisible   Boolean      @default(false)
  source              EntrySource  @default(MANUAL)
  calendarEventId     String?
  status              EntryStatus  @default(CONFIRMED)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model Expense {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  clientId      String?
  client        Client?          @relation(fields: [clientId], references: [id])
  categoryId    String
  category      ExpenseCategory  @relation(fields: [categoryId], references: [id])
  date          DateTime
  amount        Float
  description   String
  receiptUrl    String?
  isBillable    Boolean          @default(false)
  expenseType   ExpenseType
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model MileageEntry {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  clientId          String?
  client            Client?   @relation(fields: [clientId], references: [id])
  date              DateTime
  miles             Float
  purpose           String
  ratePerMile       Float     @default(0.70)
  calculatedAmount  Float
  isBillable        Boolean   @default(false)
  createdAt         DateTime  @default(now())
}

model ExpenseCategory {
  id              String                 @id @default(cuid())
  name            String                 @unique
  isOverheadOnly  Boolean                @default(false)
  isArchived      Boolean                @default(false)
  expenses        Expense[]
  projectConfigs  ProjectExpenseConfig[]
}

model RetainerConfig {
  id               String   @id @default(cuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id])
  monthlyHours     Float
  rolloverEnabled  Boolean  @default(false)
  rolloverCapHours Float?
}

model ProjectExpenseConfig {
  id                  String           @id @default(cuid())
  projectId           String
  project             Project          @relation(fields: [projectId], references: [id])
  categoryId          String
  category            ExpenseCategory  @relation(fields: [categoryId], references: [id])
  isBillableDefault   Boolean          @default(false)

  @@unique([projectId, categoryId])
}

enum ProjectType {
  FIXED_FEE
  TIME_MATERIALS
  NON_BILLABLE
}

enum ProjectStatus {
  OPEN
  CLOSED
  IN_PROGRESS
  SUBMITTED
  PENDING_AWARD
  BID_AWARDED
  BID_NOT_AWARDED
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum MilestoneStatus {
  UPCOMING
  IN_PROGRESS
  DONE
}

enum PayeeType {
  CLIENT
  SUBCONTRACTOR
}

enum EntrySource {
  MANUAL
  CALENDAR_DRAFT
  CALENDAR_CONFIRMED
}

enum EntryStatus {
  DRAFT
  CONFIRMED
}

enum ExpenseType {
  CLIENT
  OVERHEAD
}
